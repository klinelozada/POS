rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Menu item images - readable by all, writable by authenticated users
    match /menu-items/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Category images - readable by all, writable by authenticated users
    match /categories/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Payment QR codes - readable by all, writable by authenticated users
    match /payment-qr/{imageId} {
      allow read, write: if true;
    }
  }
}
