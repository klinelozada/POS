rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Menu data - public read, authenticated write
    match /categories/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /menuItems/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /addOnGroups/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Promos - public read, authenticated write
    match /promos/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Settings - public read (store status, payment methods), authenticated write
    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders - public read/create (kiosk/mobile can place orders), authenticated update/delete
    match /orders/{docId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }

    // Users - authenticated only
    match /users/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
